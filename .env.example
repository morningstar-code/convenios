# ──────────────────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL — obligatorio para Vercel; SQLite ya no se usa en código)
# ──────────────────────────────────────────────────────────────────────────────
# Ejemplo Neon / Vercel Postgres:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
#
# Local con Docker (ver docker-compose.yml):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/convenios"
#
# Migrar datos desde tu SQLite antigua SIN borrar nada en disco:
#  1. Copia de seguridad: cp prisma/dev.db prisma/dev.db.backup
#  2. DATABASE_URL=tu_neon npm run db:migrate:deploy
#  3. SQLITE_IMPORT_PATH=./prisma/dev.db npm run db:import-sqlite
#  4. PDF locales → Blob: BLOB_READ_WRITE_TOKEN=... npm run db:sync-uploads-to-blob
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/convenios"

# ──────────────────────────────────────────────────────────────────────────────
# OPENAI
# ──────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACT=gpt-4.1-nano
OPENAI_MODEL_SUMMARY=gpt-4.1-nano
OPENAI_MODEL_RECOMMEND=gpt-4.1-nano
# Hoja de ruta (4 · Seguimiento). Si no se define, usa OPENAI_MODEL_SUMMARY.
# Redacta un documento largo con tablas: conviene un modelo más capaz.
OPENAI_MODEL_ROADMAP=gpt-4.1

# ──────────────────────────────────────────────────────────────────────────────
# DRIVE
# ──────────────────────────────────────────────────────────────────────────────
# Carpeta de Google Drive donde viven los MoU originales. Si se define, aparece
# el botón "Abrir carpeta en Drive" en 5 · Comparación.
DRIVE_FOLDER_URL=

# ──────────────────────────────────────────────────────────────────────────────
# VERCEL BLOB (producción: evita depender de archivos en disco efímero)
# ──────────────────────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# AUTH
# ──────────────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ──────────────────────────────────────────────────────────────────────────────
CRON_SECRET=change-me-in-production

# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Sistema de Gestión de Convenios"
APP_URL=http://localhost:3000
